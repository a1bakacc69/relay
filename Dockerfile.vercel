# Vercel 容器部署用的 Dockerfile。
# Vercel 只认这个文件名（或 Containerfile.vercel），内容与本地开发用的
# Dockerfile 一致 —— 同一份配方，本地和线上跑的是同一个镜像。
#
# 与 Dockerfile 的唯一差别：这里不写死端口。
# Vercel 会注入 PORT 环境变量（通常为 80），由 application.properties 里的
# server.port=${PORT:8080} 接住。

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

COPY pom.xml .
RUN mvn dependency:go-offline -B

COPY src ./src
RUN mvn clean package -DskipTests -B

FROM eclipse-temurin:17-jre
WORKDIR /app

COPY --from=build /build/target/Relay-*.jar app.jar

# Vercel 默认要求监听 80，实际端口由 PORT 环境变量覆盖
EXPOSE 80

ENTRYPOINT ["java", "-jar", "app.jar"]
